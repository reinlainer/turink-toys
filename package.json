{
  "name": "turink-toys",
  "version": "0.1.0",
  "private": true,
  "description": "macOS utilities that humans and AI agents drive through the same core",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reinlainer/turink-toys.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "turink-toys": "node packages/cli/src/main.js",
    "test": "node --test packages/*/test/*.test.js",
    "app": "electron packages/app/src/main.js",
    "icons": "electron scripts/build-icons.js",
    "bundle": "npm run clean && node scripts/bundle-app.js",
    "release": "node scripts/build-release.js",
    "bundle:release": "npm run clean && node scripts/bundle-app.js --release",
    "clean": "node scripts/clean.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "electron": "^44.0.0"
  }
}
